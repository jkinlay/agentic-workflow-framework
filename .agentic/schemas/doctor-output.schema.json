{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "template_version",
    "root",
    "runtime",
    "shell",
    "commands",
    "long_argument_transport",
    "activation_summary",
    "execution_authority"
  ],
  "properties": {
    "format": {
      "const": "awf-doctor-1"
    },
    "template_version": {
      "const": "1.9.3"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreter",
        "entry_point",
        "interpreter_exists",
        "entry_point_exists"
      ],
      "properties": {
        "interpreter": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": "string",
          "minLength": 1
        },
        "interpreter_exists": {
          "type": "boolean"
        },
        "entry_point_exists": {
          "type": "boolean"
        }
      }
    },
    "shell": {
      "const": "powershell"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "command",
          "expected_exit_codes"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "adoption",
              "verification",
              "validation",
              "status",
              "operating"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "expected_exit_codes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 5
    },
    "long_argument_transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "detail"
      ],
      "properties": {
        "method": {
          "const": "json_or_response_file"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "activation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "const": "EXTENSION_POINT"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution_authority": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:doctor-output",
  "title": "Agentic Workflow 1.2 \u2014 doctor-output"
}
