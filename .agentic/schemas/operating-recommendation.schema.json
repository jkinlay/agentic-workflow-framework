{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "created_at",
    "operating_hash",
    "governance_hash",
    "inputs",
    "input_files",
    "input_content",
    "rows",
    "epic_count",
    "ticket_count",
    "execution_authority",
    "applied"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^R-[0-9a-f]{24}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "format": "date-time",
      "maxLength": 40
    },
    "operating_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "governance_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epics",
        "inventory"
      ],
      "properties": {
        "epics": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inventory": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "input_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epics",
        "inventory"
      ],
      "properties": {
        "epics": {
          "type": [
            "string",
            "null"
          ]
        },
        "inventory": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "input_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epics",
        "inventory"
      ],
      "properties": {
        "epics": {
          "type": "string",
          "maxLength": 1048576
        },
        "inventory": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1048576
        }
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 14016,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "current",
          "recommended",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "current": {},
          "recommended": {},
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "epic_count": {
      "type": "integer",
      "minimum": 0
    },
    "ticket_count": {
      "type": "integer",
      "minimum": 0
    },
    "execution_authority": {
      "const": false
    },
    "applied": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:operating-recommendation",
  "title": "Agentic Workflow 1.2 \u2014 operating-recommendation"
}
