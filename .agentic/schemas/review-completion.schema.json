{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "state",
    "current",
    "ready",
    "tuple",
    "tuple_sha256",
    "required_reviewers",
    "reviewer_set_sha256",
    "counts",
    "reviewers",
    "completion_snapshot_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "state": {
      "enum": [
        "COLLECTING",
        "SUBMITTING",
        "SUBMITTED",
        "SUBMISSION_UNKNOWN",
        "INVALIDATED"
      ]
    },
    "current": {
      "type": "boolean"
    },
    "ready": {
      "type": "boolean"
    },
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_sha",
        "head_sha",
        "head_tree_sha",
        "contract_sha256",
        "review_input_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_tree_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "contract_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_input_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tuple_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reviewer_set_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "completed",
        "acceptable",
        "failed",
        "stale",
        "outstanding"
      ],
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outstanding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "state"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "MISSING",
              "RUNNING",
              "ACCEPTABLE",
              "FAILED",
              "TIMED_OUT",
              "MALFORMED",
              "CANCELLED",
              "STALE",
              "DUPLICATE"
            ]
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "completion_snapshot_sha256": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "exported_round_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "critic_artifact_binding",
          "completion_cycle_id",
          "completion_tuple_sha256",
          "completion_reviewer_set_sha256",
          "completion_snapshot_json",
          "completion_snapshot_sha256",
          "review_verdict_json",
          "review_verdict_sha256",
          "posting_observation_json",
          "posting_observation_sha256"
        ],
        "properties": {
          "critic_artifact_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "critic_run_id",
              "result_sha256",
              "head_sha",
              "round"
            ],
            "properties": {
              "critic_run_id": {
                "type": "string",
                "minLength": 1,
                "format": "uuid"
              },
              "result_sha256": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{64}$"
              },
              "head_sha": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{40}$"
              },
              "round": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              }
            }
          },
          "result_json": {
            "type": "string",
            "minLength": 2
          },
          "completion_cycle_id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "completion_tuple_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "completion_reviewer_set_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "completion_snapshot_json": {
            "type": "string",
            "minLength": 2
          },
          "completion_snapshot_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "review_verdict_json": {
            "type": "string",
            "minLength": 2
          },
          "review_verdict_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "posting_observation_json": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encoding",
              "data"
            ],
            "properties": {
              "encoding": {
                "const": "base64"
              },
              "data": {
                "type": "string",
                "minLength": 4,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              }
            }
          },
          "posting_observation_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ready": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "COLLECTING"
          },
          "current": {
            "const": true
          },
          "counts": {
            "properties": {
              "failed": {
                "const": 0
              },
              "stale": {
                "const": 0
              },
              "outstanding": {
                "const": 0
              }
            }
          },
          "reviewers": {
            "items": {
              "properties": {
                "state": {
                  "const": "ACCEPTABLE"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:review-completion",
  "title": "Agentic Workflow 1.2 \u2014 review-completion"
}
