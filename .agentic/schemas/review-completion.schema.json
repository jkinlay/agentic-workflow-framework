{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cycle_id",
    "state",
    "current",
    "ready",
    "tuple",
    "tuple_sha256",
    "required_reviewers",
    "reviewer_set_sha256",
    "counts",
    "reviewers",
    "completion_snapshot_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "state": {
      "enum": [
        "COLLECTING",
        "SUBMITTING",
        "SUBMITTED",
        "SUBMISSION_UNKNOWN",
        "INVALIDATED"
      ]
    },
    "current": {
      "type": "boolean"
    },
    "ready": {
      "type": "boolean"
    },
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_sha",
        "head_sha",
        "head_tree_sha",
        "contract_sha256",
        "review_input_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_tree_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "contract_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_input_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tuple_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reviewer_set_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "completed",
        "acceptable",
        "failed",
        "stale",
        "outstanding"
      ],
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acceptable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outstanding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "state"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "MISSING",
              "RUNNING",
              "ACCEPTABLE",
              "FAILED",
              "TIMED_OUT",
              "MALFORMED",
              "STALE",
              "DUPLICATE"
            ]
          }
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "completion_snapshot_sha256": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:review-completion",
  "title": "Agentic Workflow 1.2 \u2014 review-completion"
}
