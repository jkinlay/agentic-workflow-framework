{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "merged_ticket",
    "scope",
    "observed_at",
    "closed",
    "remaining_open",
    "jira_state",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "merged_ticket": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "closed": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "const": "UNOBSERVED"
        }
      ]
    },
    "remaining_open": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "const": "UNOBSERVED"
        }
      ]
    },
    "jira_state": {
      "enum": [
        "RECONCILED",
        "UNOBSERVED",
        "JIRA_DISABLED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:jira-progress",
  "title": "Agentic Workflow 1.2 \u2014 jira-progress"
}
