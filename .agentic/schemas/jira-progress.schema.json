{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "merged_ticket",
    "scope",
    "scope_sha256",
    "include_epics",
    "snapshot_id",
    "observed_at",
    "closed",
    "remaining_open",
    "jira_state",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "merged_ticket": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "scope_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "include_epics": {
      "type": "boolean"
    },
    "snapshot_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "closed": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "const": "UNOBSERVED"
        }
      ]
    },
    "remaining_open": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "const": "UNOBSERVED"
        }
      ]
    },
    "jira_state": {
      "enum": [
        "COUNTED",
        "RECONCILED",
        "UNOBSERVED",
        "JIRA_DISABLED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "jira_state": {
            "const": "COUNTED"
          }
        }
      },
      "then": {
        "properties": {
          "closed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "remaining_open": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "jira_state": {
            "enum": [
              "RECONCILED",
              "UNOBSERVED",
              "JIRA_DISABLED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "closed": {
            "const": "UNOBSERVED"
          },
          "remaining_open": {
            "const": "UNOBSERVED"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:jira-progress",
  "title": "Agentic Workflow 1.2 \u2014 jira-progress"
}
