{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "created_at",
    "instruction",
    "before_hash",
    "after_hash",
    "changes",
    "source",
    "applied_from",
    "sequence",
    "previous_change_id",
    "governance_hash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^C-[0-9a-f]{32}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "format": "date-time",
      "maxLength": 40
    },
    "instruction": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 65536
    },
    "before_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "after_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "before",
          "after"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "before": {},
          "after": {}
        }
      }
    },
    "source": {
      "type": "string",
      "pattern": "^(default|user|recommendation:R-[0-9a-f]{24})$"
    },
    "applied_from": {
      "enum": [
        "chat",
        "bootstrap"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_change_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^C-[0-9a-f]{32}$"
    },
    "governance_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reporting_owner_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "actor_id",
        "project_id",
        "prior_settings_hash",
        "changes"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "prior_settings_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "changes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "off",
                "teams",
                "slack",
                "both"
              ]
            },
            "bindings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "project",
                  "repository",
                  "scope_revision",
                  "platform",
                  "destination",
                  "revision",
                  "secret_ref"
                ],
                "properties": {
                  "project": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "repository": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "scope_revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "platform": {
                    "enum": [
                      "teams",
                      "slack"
                    ]
                  },
                  "destination": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "secret_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^(env|vault|secret):[A-Za-z0-9_./-]+$"
                  }
                }
              },
              "minItems": 0,
              "maxItems": 2
            }
          }
        }
      }
    },
    "budget_owner_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "actor_id",
        "project_id",
        "prior_settings_hash",
        "changes"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "prior_settings_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "changes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "accounting_enabled": {
              "type": "boolean"
            },
            "enforcement_enabled": {
              "type": "boolean"
            },
            "max_tokens_per_ticket": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_tokens_per_project": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "calendar_owner_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "actor_id",
        "project_id",
        "prior_settings_hash",
        "changes"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "prior_settings_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "work_mode": {
              "const": "continuous"
            },
            "review_batching.enabled": {
              "type": "boolean"
            },
            "review_batching.weekdays": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true
            },
            "review_batching.presentation_time": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "review_batching.cutoff_time": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "eod.time": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "eod.weekdays": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true
            }
          },
          "minProperties": 1
        }
      }
    },
    "owner_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "login",
        "type",
        "digest",
        "request_id",
        "confirmed_at",
        "executable_path",
        "executable_sha256"
      ],
      "properties": {
        "actor_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39
        },
        "type": {
          "const": "User"
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "confirmed_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "executable_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "executable_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applied_from": {
            "const": "chat"
          }
        }
      },
      "then": {
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "instruction": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:operating-change",
  "title": "Agentic Workflow 1.2 \u2014 operating-change"
}
