{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "producer_id",
    "run_id",
    "binding",
    "verdict",
    "tier",
    "round",
    "head_sha",
    "reviewer_id",
    "pr_comment_url",
    "pr_body_link",
    "evidence",
    "owner_review",
    "provider_observed",
    "owner_id",
    "candidate_binding",
    "provider_receipt"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id",
        "issue_id",
        "requirements_hash",
        "contract_hash",
        "policy_hash",
        "candidate_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "P1",
        "P2",
        "REQUEST_CHANGES"
      ]
    },
    "tier": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "head_sha": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "pr_comment_url": {
      "type": "string",
      "minLength": 1,
      "format": "uri"
    },
    "pr_body_link": {
      "type": "string",
      "minLength": 1,
      "format": "uri"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "owner_review": {
      "type": "boolean"
    },
    "provider_observed": {
      "type": "boolean"
    },
    "owner_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "pr_number",
        "base_sha",
        "head_sha"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "base_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "provider_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable_id",
        "provider",
        "evidence_sha256",
        "candidate_binding",
        "owner_id"
      ],
      "properties": {
        "immutable_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_id",
            "pr_number",
            "base_sha",
            "head_sha"
          ],
          "properties": {
            "repository_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "pr_number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "base_sha": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{40}$"
            },
            "head_sha": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "owner_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:review-verdict",
  "title": "Agentic Workflow 1.2 \u2014 review-verdict"
}
