{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "created_at",
    "binding",
    "github_identity",
    "jira_connections"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id",
        "repository",
        "cloud_id",
        "provider_project_id",
        "project_key",
        "release_sha256"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "cloud_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_key": {
          "type": "string",
          "minLength": 1
        },
        "release_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "github_identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_id",
            "actor_login",
            "auth_profile",
            "repository_id",
            "repository",
            "readable",
            "protocol",
            "observed_at"
          ],
          "properties": {
            "actor_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "actor_login": {
              "type": "string",
              "minLength": 1
            },
            "auth_profile": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "repository_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "readable": {
              "type": "boolean"
            },
            "protocol": {
              "enum": [
                "https",
                "ssh"
              ]
            },
            "observed_at": {
              "type": "string",
              "minLength": 1,
              "format": "date-time"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "jira_connections": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connection_id",
              "cloud_id",
              "site",
              "account_id",
              "account_login",
              "observed_at",
              "projects"
            ],
            "properties": {
              "connection_id": {
                "type": "string",
                "minLength": 1
              },
              "cloud_id": {
                "type": "string",
                "minLength": 1
              },
              "site": {
                "type": "string",
                "minLength": 1,
                "format": "uri"
              },
              "account_id": {
                "type": "string",
                "minLength": 1
              },
              "account_login": {
                "type": "string",
                "minLength": 1
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "format": "date-time"
              },
              "projects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "project_id",
                    "project_key",
                    "browse"
                  ],
                  "properties": {
                    "project_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "project_key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "browse": {
                      "type": "boolean"
                    }
                  }
                },
                "minItems": 0
              }
            }
          },
          "minItems": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "inventory": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source",
            "tickets"
          ],
          "properties": {
            "status": {
              "const": "KNOWN"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "tickets": {
              "type": "array",
              "items": {
                "type": "object",
                "$comment": "Requires the producer semantic verifier before projection."
              },
              "minItems": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "assignments": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "$comment": "Requires the producer semantic verifier before projection."
          },
          "minItems": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "oneOf": [
        {
          "type": "object",
          "$comment": "Requires the producer semantic verifier before projection."
        },
        {
          "type": "null"
        }
      ]
    },
    "override_state": {
      "oneOf": [
        {
          "type": "object",
          "$comment": "Requires the producer semantic verifier before projection."
        },
        {
          "type": "null"
        }
      ]
    },
    "planning_graph": {
      "oneOf": [
        {
          "type": "object",
          "$comment": "Requires the producer semantic verifier before projection."
        },
        {
          "type": "null"
        }
      ]
    },
    "merge_train": {
      "oneOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "const": "UNKNOWN"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "enabled",
                "cadence_minutes",
                "source",
                "source_owner_review"
              ],
              "properties": {
                "status": {
                  "const": "KNOWN"
                },
                "enabled": {
                  "type": "boolean"
                },
                "cadence_minutes": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "source_owner_review": {
                  "const": "normal_tier_final_gate"
                },
                "schedule": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "reason"
                      ],
                      "properties": {
                        "kind": {
                          "const": "UNKNOWN"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "minutes"
                      ],
                      "properties": {
                        "kind": {
                          "const": "INTERVAL"
                        },
                        "minutes": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "timezone",
                        "slots"
                      ],
                      "properties": {
                        "kind": {
                          "const": "UTC_DAILY_SLOTS"
                        },
                        "timezone": {
                          "const": "UTC"
                        },
                        "slots": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:status-report-input",
  "title": "Agentic Workflow 1.2 \u2014 status-report-input"
}
