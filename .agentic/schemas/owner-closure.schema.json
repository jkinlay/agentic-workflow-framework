{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "created_at",
    "producer_id",
    "run_id",
    "binding",
    "merge_result_id",
    "closure_kind",
    "rationale",
    "authorization_request_id",
    "owner_source",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id",
        "issue_id",
        "requirements_hash",
        "contract_hash",
        "policy_hash",
        "candidate_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "merge_result_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "closure_kind": {
      "enum": [
        "release",
        "publication",
        "qualification",
        "cutover",
        "production_acceptance",
        "other"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "authorization_request_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "owner_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "comment_id",
        "actor_id",
        "actor_login",
        "raw_body",
        "raw_body_sha256",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "channel": {
          "const": "github_pr_comment"
        },
        "comment_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actor_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actor_login": {
          "type": "string",
          "minLength": 1
        },
        "raw_body": {
          "type": "string",
          "minLength": 1
        },
        "raw_body_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "shared_owner_automation_account": {
      "const": true
    },
    "owner_policy_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "accepted_owner_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "shared_owner_automation_actor_id",
        "policy_sha256",
        "config_sha256",
        "workflow_sha256",
        "default_branch_ref",
        "default_branch_commit",
        "warnings",
        "execution_authority"
      ],
      "properties": {
        "status": {
          "const": "OBSERVED"
        },
        "shared_owner_automation_actor_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "workflow_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "default_branch_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^refs/remotes/origin/.+$"
        },
        "default_branch_commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "code",
              "message"
            ],
            "properties": {
              "path": {
                "const": "$.merge_gate.shared_owner_automation_actor_id"
              },
              "code": {
                "const": "SHARED_OWNER_AUTOMATION_ACCOUNT"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1,
          "maxItems": 1
        },
        "execution_authority": {
          "const": false
        }
      }
    }
  },
  "dependentRequired": {
    "shared_owner_automation_account": [
      "owner_policy_sha256",
      "accepted_owner_policy"
    ],
    "owner_policy_sha256": [
      "shared_owner_automation_account",
      "accepted_owner_policy"
    ],
    "accepted_owner_policy": [
      "shared_owner_automation_account",
      "owner_policy_sha256"
    ]
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:owner-closure",
  "title": "Agentic Workflow 1.2 \u2014 owner-closure"
}
