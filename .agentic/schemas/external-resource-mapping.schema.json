{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:external-resource-mapping",
  "title": "Agentic Workflow 1.2 — external-resource-mapping (operator local)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "resources"],
  "properties": {
    "format": {"const": "awf-external-resource-mapping-1"},
    "resources": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_path", "canonical_locator", "mapping_kind"],
        "properties": {
          "local_path": {"type": "string", "minLength": 1},
          "canonical_locator": {"type": "string", "minLength": 1},
          "mapping_kind": {"enum": ["local", "mapped_drive", "unc"]}
        }
      }
    }
  }
}
