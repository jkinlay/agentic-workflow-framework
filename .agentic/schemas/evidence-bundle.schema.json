{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "snapshot",
    "contract",
    "dispatch",
    "worker",
    "critic",
    "specialists",
    "ci",
    "pr",
    "runs",
    "prior_findings",
    "finding_dispositions",
    "cap_disposition",
    "publication_scan",
    "evidence_registry",
    "provenance_mode"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "candidate": {
      "$ref": "urn:awf:1.2:candidate"
    },
    "snapshot": {
      "$ref": "urn:awf:1.2:jira-snapshot"
    },
    "contract": {
      "$ref": "urn:awf:1.2:ticket-contract"
    },
    "dispatch": {
      "$ref": "urn:awf:1.2:work-dispatch"
    },
    "worker": {
      "$ref": "urn:awf:1.2:worker-result"
    },
    "critic": {
      "$ref": "urn:awf:1.2:critic-review"
    },
    "specialists": {
      "type": "array",
      "items": {
        "$ref": "urn:awf:1.2:specialist-review"
      },
      "minItems": 0
    },
    "ci": {
      "$ref": "urn:awf:1.2:ci-evidence"
    },
    "pr": {
      "$ref": "urn:awf:1.2:pr-snapshot"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "urn:awf:1.2:run-attestation"
      },
      "minItems": 3
    },
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "summary",
          "evidence",
          "status",
          "resolution_evidence",
          "basis",
          "supersedes_finding_id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR",
              "NIT"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED",
              "DISPUTED"
            ]
          },
          "resolution_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "basis": {
            "oneOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "criterion_id"
                    ],
                    "properties": {
                      "criterion_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "boundary_code"
                    ],
                    "properties": {
                      "boundary_code": {
                        "enum": [
                          "PROTECTED_PATH",
                          "SCOPE_ESCAPE",
                          "CREDENTIAL_EXPOSURE",
                          "UNSAFE_PATH",
                          "UNREGISTERED_PRODUCER",
                          "CI_BINDING",
                          "INDEPENDENCE"
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "supersedes_finding_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "severity": {
                  "enum": [
                    "BLOCKER",
                    "MAJOR"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "basis": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "criterion_id"
                      ],
                      "properties": {
                        "criterion_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "boundary_code"
                      ],
                      "properties": {
                        "boundary_code": {
                          "enum": [
                            "PROTECTED_PATH",
                            "SCOPE_ESCAPE",
                            "CREDENTIAL_EXPOSURE",
                            "UNSAFE_PATH",
                            "UNREGISTERED_PRODUCER",
                            "CI_BINDING",
                            "INDEPENDENCE"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "finding_dispositions": {
      "type": "array",
      "items": {
        "$ref": "urn:awf:1.2:finding-disposition"
      },
      "minItems": 0
    },
    "cap_disposition": {
      "oneOf": [
        {
          "$ref": "urn:awf:1.2:review-cap-disposition"
        },
        {
          "type": "null"
        }
      ]
    },
    "publication_scan": {
      "$ref": "urn:awf:1.2:publication-scan"
    },
    "evidence_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "sha256",
          "producer_id",
          "retained_until"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "producer_id": {
            "type": "string",
            "minLength": 1
          },
          "retained_until": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          }
        }
      },
      "minItems": 1
    },
    "provenance_mode": {
      "const": "offline_fixture"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:evidence-bundle",
  "title": "Agentic Workflow 1.2 \u2014 evidence-bundle"
}
