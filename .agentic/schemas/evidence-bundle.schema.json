{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "snapshot",
    "contract",
    "dispatch",
    "worker",
    "critic",
    "specialists",
    "review_submission",
    "ci",
    "pr",
    "runs",
    "prior_findings",
    "finding_dispositions",
    "cap_disposition",
    "publication_scan",
    "tier_classification",
    "review_verdicts",
    "ticketed_p2_records",
    "evidence_registry",
    "provenance_mode"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "candidate": {
      "$ref": "urn:awf:1.2:candidate"
    },
    "snapshot": {
      "$ref": "urn:awf:1.2:jira-snapshot"
    },
    "contract": {
      "$ref": "urn:awf:1.2:ticket-contract"
    },
    "dispatch": {
      "$ref": "urn:awf:1.2:work-dispatch"
    },
    "worker": {
      "$ref": "urn:awf:1.2:worker-result"
    },
    "critic": {
      "$ref": "urn:awf:1.2:critic-review"
    },
    "specialists": {
      "type": "array",
      "items": {
        "$ref": "urn:awf:1.2:specialist-review"
      },
      "minItems": 0
    },
    "review_submission": {
      "$ref": "urn:awf:1.2:review-submission"
    },
    "ci": {
      "$ref": "urn:awf:1.2:ci-evidence"
    },
    "pr": {
      "$ref": "urn:awf:1.2:pr-snapshot"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "urn:awf:1.2:run-attestation"
      },
      "minItems": 3
    },
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "summary",
          "evidence",
          "status",
          "resolution_evidence",
          "basis",
          "supersedes_finding_id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR",
              "NIT"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED",
              "DISPUTED"
            ]
          },
          "resolution_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "basis": {
            "oneOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "criterion_id"
                    ],
                    "properties": {
                      "criterion_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "boundary_code"
                    ],
                    "properties": {
                      "boundary_code": {
                        "enum": [
                          "PROTECTED_PATH",
                          "SCOPE_ESCAPE",
                          "CREDENTIAL_EXPOSURE",
                          "UNSAFE_PATH",
                          "UNREGISTERED_PRODUCER",
                          "CI_BINDING",
                          "INDEPENDENCE"
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "supersedes_finding_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "severity": {
                  "enum": [
                    "BLOCKER",
                    "MAJOR"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "basis": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "criterion_id"
                      ],
                      "properties": {
                        "criterion_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "boundary_code"
                      ],
                      "properties": {
                        "boundary_code": {
                          "enum": [
                            "PROTECTED_PATH",
                            "SCOPE_ESCAPE",
                            "CREDENTIAL_EXPOSURE",
                            "UNSAFE_PATH",
                            "UNREGISTERED_PRODUCER",
                            "CI_BINDING",
                            "INDEPENDENCE"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    },
    "finding_dispositions": {
      "type": "array",
      "items": {
        "$ref": "urn:awf:1.2:finding-disposition"
      },
      "minItems": 0
    },
    "cap_disposition": {
      "oneOf": [
        {
          "$ref": "urn:awf:1.2:review-cap-disposition"
        },
        {
          "type": "null"
        }
      ]
    },
    "publication_scan": {
      "$ref": "urn:awf:1.2:publication-scan"
    },
    "tier_classification": {
      "oneOf": [
        {
          "$ref": "urn:awf:1.2:risk-classification"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_verdicts": {
      "type": "array",
      "items": {
        "$ref": "urn:awf:1.2:review-verdict"
      },
      "minItems": 1
    },
    "review_round_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "critic_artifact_binding",
          "completion_cycle_id",
          "completion_tuple_sha256",
          "completion_reviewer_set_sha256",
          "completion_snapshot_json",
          "completion_snapshot_sha256",
          "review_verdict_json",
          "review_verdict_sha256",
          "posting_observation_json",
          "posting_observation_sha256"
        ],
        "properties": {
          "critic_artifact_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "critic_run_id",
              "result_sha256",
              "head_sha",
              "round"
            ],
            "properties": {
              "critic_run_id": {
                "type": "string",
                "minLength": 1,
                "format": "uuid"
              },
              "result_sha256": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{64}$"
              },
              "head_sha": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{40}$"
              },
              "round": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          },
          "result_json": {
            "type": "string",
            "minLength": 2
          },
          "completion_cycle_id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "completion_tuple_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "completion_reviewer_set_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "completion_snapshot_json": {
            "type": "string",
            "minLength": 2
          },
          "completion_snapshot_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "review_verdict_json": {
            "type": "string",
            "minLength": 2
          },
          "review_verdict_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "posting_observation_json": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encoding",
              "data"
            ],
            "properties": {
              "encoding": {
                "const": "base64"
              },
              "data": {
                "type": "string",
                "minLength": 4,
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              }
            }
          },
          "posting_observation_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0
    },
    "ticketed_p2_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "ticket_key"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "ticket_key": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "owner_review": {
      "oneOf": [
        {
          "$ref": "urn:awf:1.2:review-verdict"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "sha256",
          "producer_id",
          "retained_until"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "producer_id": {
            "type": "string",
            "minLength": 1
          },
          "retained_until": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          }
        }
      },
      "minItems": 1
    },
    "provenance_mode": {
      "enum": [
        "offline_fixture",
        "production_observation"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:evidence-bundle",
  "title": "Agentic Workflow 1.2 \u2014 evidence-bundle"
}
