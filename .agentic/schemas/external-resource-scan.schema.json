{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:external-resource-scan",
  "title": "Agentic Workflow 1.2 — external-resource-scan",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "status", "resource_alias", "bounds", "execution_authority"],
  "properties": {
    "format": {"const": "awf-external-resource-scan-1"},
    "status": {"const": "BOUNDED_SCAN_ACCEPTED"},
    "resource_alias": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recursive", "max_depth", "file_limit", "date_range", "timeout_seconds"],
      "properties": {
        "recursive": {"type": "boolean"},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 32},
        "file_limit": {"type": "integer", "minimum": 1, "maximum": 100000},
        "date_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          }
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "execution_authority": {"const": false}
  }
}
