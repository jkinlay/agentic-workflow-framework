{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "created_at",
    "producer_id",
    "run_id",
    "binding",
    "verdict",
    "acceptance_criteria",
    "findings",
    "prior_finding_ids",
    "coverage",
    "evidence_checked"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id",
        "issue_id",
        "requirements_hash",
        "contract_hash",
        "policy_hash",
        "candidate_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verdict": {
      "enum": [
        "APPROVE",
        "REQUEST_CHANGES",
        "INCOMPLETE"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verdict",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "summary",
          "evidence",
          "status",
          "resolution_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR",
              "NIT"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED",
              "DISPUTED"
            ]
          },
          "resolution_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0
    },
    "prior_finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "file_manifest_sha256",
        "reviewed_paths",
        "omissions"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "file_manifest_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "evidence_checked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "APPROVE"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "acceptance_criteria": {
            "items": {
              "properties": {
                "verdict": {
                  "const": "PASS"
                }
              }
            }
          },
          "findings": {
            "not": {
              "contains": {
                "type": "object",
                "required": [
                  "severity",
                  "status"
                ],
                "properties": {
                  "severity": {
                    "enum": [
                      "BLOCKER",
                      "MAJOR"
                    ]
                  },
                  "status": {
                    "enum": [
                      "OPEN",
                      "DISPUTED"
                    ]
                  }
                }
              }
            }
          },
          "coverage": {
            "properties": {
              "complete": {
                "const": true
              },
              "omissions": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:critic-review",
  "title": "Agentic Workflow 1.2 \u2014 critic-review"
}
