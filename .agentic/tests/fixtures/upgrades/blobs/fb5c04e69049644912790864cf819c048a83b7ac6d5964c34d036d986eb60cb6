{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "project_id",
    "task_id",
    "fencing_token",
    "control_generation",
    "resource_class",
    "worker_slots",
    "heavy_slots",
    "gpu_slots",
    "issued_at",
    "expires_at",
    "status",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "lease_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "control_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "resource_class": {
      "enum": [
        "standard",
        "heavy",
        "gpu"
      ]
    },
    "worker_slots": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "heavy_slots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gpu_slots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issued_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "EXPIRED",
        "RELEASED",
        "REVOKED"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:host-lease",
  "title": "Agentic Workflow 1.2 \u2014 host-lease"
}
