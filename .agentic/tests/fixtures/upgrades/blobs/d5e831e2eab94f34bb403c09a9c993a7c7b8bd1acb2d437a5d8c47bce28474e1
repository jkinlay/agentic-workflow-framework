{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submission_id",
    "cycle_id",
    "completion_snapshot",
    "completion_snapshot_sha256",
    "aggregate",
    "aggregate_sha256",
    "provider_preconditions",
    "execution_authority"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "completion_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_id",
        "tuple",
        "tuple_sha256",
        "required_reviewers",
        "reviewer_set_sha256",
        "counts",
        "results"
      ],
      "properties": {
        "cycle_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "tuple": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "base_sha",
            "head_sha",
            "head_tree_sha",
            "contract_sha256",
            "review_input_sha256"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "base_sha": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{40}$"
            },
            "head_sha": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{40}$"
            },
            "head_tree_sha": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{40}$"
            },
            "contract_sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}$"
            },
            "review_input_sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "tuple_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_reviewers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reviewer_set_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "completed",
            "acceptable",
            "failed",
            "stale",
            "outstanding"
          ],
          "properties": {
            "required": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "acceptable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "stale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outstanding": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer_id",
              "state",
              "result_sha256",
              "terminal_at"
            ],
            "properties": {
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "const": "ACCEPTABLE"
              },
              "result_sha256": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{64}$"
              },
              "terminal_at": {
                "type": "string",
                "minLength": 1,
                "format": "date-time"
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "completion_snapshot_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "aggregate": {},
    "aggregate_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "prepared_at",
        "repository",
        "base_sha",
        "head_sha",
        "head_tree_sha",
        "tuple_sha256",
        "reviewer_set_sha256",
        "completion_snapshot_sha256",
        "aggregate_sha256"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "prepared_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_tree_sha": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "tuple_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer_set_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "completion_snapshot_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "aggregate_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "execution_authority": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:review-submission",
  "title": "Agentic Workflow 1.2 \u2014 review-submission"
}
