{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "project_key",
    "summary",
    "description",
    "acceptance_criteria",
    "dependencies",
    "linked_requirements",
    "epic_ids",
    "labels",
    "component_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "project_key": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 0
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "ticket",
          "kind",
          "direction",
          "satisfied",
          "target",
          "evidence"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "ticket": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "code",
              "deployment",
              "migration",
              "environment"
            ]
          },
          "direction": {
            "const": "requires"
          },
          "satisfied": {
            "type": "boolean"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0
    },
    "linked_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "version",
          "sha256"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 0
    },
    "epic_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "component_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:jira-snapshot",
  "title": "Agentic Workflow 1.2 \u2014 jira-snapshot"
}
