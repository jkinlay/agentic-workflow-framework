{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "created_at",
    "producer_id",
    "run_id",
    "binding",
    "reason_code",
    "summary",
    "evidence",
    "resume_state",
    "resolved",
    "resolution_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id",
        "issue_id",
        "requirements_hash",
        "contract_hash",
        "policy_hash",
        "candidate_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "resume_state": {
      "enum": [
        "READY",
        "IN_PROGRESS",
        "READY_FOR_CRITIC",
        "CHANGES_REQUESTED",
        "SPECIALIST_REVIEW",
        "FINAL_REVIEW",
        "MERGED_PENDING_JIRA"
      ]
    },
    "resolved": {
      "type": "boolean"
    },
    "resolution_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uri"
      },
      "minItems": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:blocker",
  "title": "Agentic Workflow 1.2 \u2014 blocker"
}
