{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "refreshed_at",
    "sequence",
    "event_hash",
    "control_mode",
    "control_generation",
    "tickets",
    "pending_operation_ids",
    "unknown_operation_ids",
    "active_lease_ids",
    "owner_actions",
    "authoritative"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "refreshed_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "event_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "control_mode": {
      "enum": [
        "PAUSED",
        "RUNNING",
        "STOPPED"
      ]
    },
    "control_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "state",
          "revision"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "BACKLOG",
              "READY",
              "DISPATCHED",
              "IN_PROGRESS",
              "PR_DRAFT",
              "READY_FOR_CRITIC",
              "CHANGES_REQUESTED",
              "AMENDING",
              "SPECIALIST_REVIEW",
              "FINAL_REVIEW",
              "READY_FOR_OWNER_AUTHORIZATION",
              "OWNER_AUTHORIZED",
              "MERGING",
              "MERGE_UNKNOWN",
              "MERGED",
              "MERGED_PENDING_JIRA",
              "DONE",
              "BLOCKED",
              "FAILED",
              "CANCELLED",
              "SUPERSEDED",
              "REOPENED"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 0
    },
    "pending_operation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "unknown_operation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "active_lease_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "owner_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "authoritative": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:project-state",
  "title": "Agentic Workflow 1.2 \u2014 project-state"
}
