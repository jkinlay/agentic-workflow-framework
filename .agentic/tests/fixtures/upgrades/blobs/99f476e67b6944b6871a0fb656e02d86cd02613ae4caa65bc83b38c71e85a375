{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "created_at",
    "producer_id",
    "run_id",
    "binding",
    "previous_state",
    "resume_state",
    "blocker_id",
    "reconciliation_id",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id",
        "issue_id",
        "requirements_hash",
        "contract_hash",
        "policy_hash",
        "candidate_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "previous_state": {
      "enum": [
        "BACKLOG",
        "READY",
        "DISPATCHED",
        "IN_PROGRESS",
        "PR_DRAFT",
        "READY_FOR_CRITIC",
        "CHANGES_REQUESTED",
        "AMENDING",
        "SPECIALIST_REVIEW",
        "FINAL_REVIEW",
        "READY_FOR_OWNER_AUTHORIZATION",
        "OWNER_AUTHORIZED",
        "MERGING",
        "MERGE_UNKNOWN",
        "MERGED",
        "MERGED_PENDING_JIRA",
        "DONE",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "SUPERSEDED",
        "REOPENED",
        "REVIEW_CAP_REACHED",
        "MERGED_PENDING_OWNER_CLOSURE"
      ]
    },
    "resume_state": {
      "enum": [
        "BACKLOG",
        "READY",
        "DISPATCHED",
        "IN_PROGRESS",
        "PR_DRAFT",
        "READY_FOR_CRITIC",
        "CHANGES_REQUESTED",
        "AMENDING",
        "SPECIALIST_REVIEW",
        "FINAL_REVIEW",
        "READY_FOR_OWNER_AUTHORIZATION",
        "OWNER_AUTHORIZED",
        "MERGING",
        "MERGE_UNKNOWN",
        "MERGED",
        "MERGED_PENDING_JIRA",
        "DONE",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "SUPERSEDED",
        "REOPENED",
        "REVIEW_CAP_REACHED",
        "MERGED_PENDING_OWNER_CLOSURE"
      ]
    },
    "blocker_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "reconciliation_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:recovery",
  "title": "Agentic Workflow 1.2 \u2014 recovery"
}
