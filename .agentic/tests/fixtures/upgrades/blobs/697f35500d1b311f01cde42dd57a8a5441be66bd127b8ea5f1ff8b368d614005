# Inert external-review policy example. Not the active .agentic/project.yaml.
# Preserve the project's accepted engine. Keep AWF_ENABLE_CLAUDE_REVIEW unset
# until the environments and actual engine are independently qualified.
review:
  required_external_engine: copilot
  optional_engines:
    - claude
  reviewer_identities:
    claude: "__AWF_REVIEWER_BOT_LOGIN__"
  claude:
    model: "__AWF_PINNED_CLAUDE_MODEL__"
    base_url: https://api.anthropic.com
    task_contract_path: .agentic/task-contract.yaml
    execution_report_path: .agentic/execution-report.json
  qualification:
    effective_permissions_verified: false
    instruction_paths_protected: false
    head_binding_verified: false
    live_benchmark_verified: false
    environment_secret_boundaries_verified: false
