{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "created_at",
    "producer_id",
    "run_id",
    "binding",
    "operation_id",
    "merge_result_id",
    "lifecycle_event",
    "from_status_id",
    "to_status_id",
    "transition_id",
    "status",
    "evidence",
    "read_back"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id",
        "issue_id",
        "requirements_hash",
        "contract_hash",
        "policy_hash",
        "candidate_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "merge_result_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle_event": {
      "enum": [
        "WORKER_STARTED",
        "PR_READY",
        "OWNER_CHANGES_REQUESTED",
        "HEAD_CHANGED",
        "JIRA_RECONCILED"
      ]
    },
    "from_status_id": {
      "type": "string",
      "minLength": 1
    },
    "to_status_id": {
      "type": "string",
      "minLength": 1
    },
    "transition_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "UNKNOWN",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "read_back": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_status",
        "observed_actor",
        "observed_at"
      ],
      "properties": {
        "observed_status": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_actor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_event": {
            "const": "JIRA_RECONCILED"
          }
        },
        "required": [
          "lifecycle_event"
        ]
      },
      "then": {
        "properties": {
          "merge_result_id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:jira-transition",
  "title": "Agentic Workflow 1.2 \u2014 jira-transition"
}
