{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "created_at",
    "producer_id",
    "run_id",
    "binding",
    "decision",
    "open_finding_ids",
    "notes",
    "cycles",
    "cap_extensions",
    "successor_ticket",
    "authorization_request_id",
    "owner_source",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id",
        "issue_id",
        "requirements_hash",
        "contract_hash",
        "policy_hash",
        "candidate_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision": {
      "enum": [
        "MERGE_WITH_NOTES",
        "PARK",
        "RESCOPE",
        "EXTEND_ONE_CYCLE"
      ]
    },
    "open_finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "minLength": 0
    },
    "cycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cap_extensions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "successor_ticket": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "authorization_request_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "owner_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "comment_id",
        "actor_id",
        "actor_login",
        "raw_body",
        "raw_body_sha256",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "channel": {
          "const": "github_pr_comment"
        },
        "comment_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actor_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "actor_login": {
          "type": "string",
          "minLength": 1
        },
        "raw_body": {
          "type": "string",
          "minLength": 1
        },
        "raw_body_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "RESCOPE"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "successor_ticket": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:review-cap-disposition",
  "title": "Agentic Workflow 1.2 \u2014 review-cap-disposition"
}
