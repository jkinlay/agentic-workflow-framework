{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "created_at",
    "producer_id",
    "run_id",
    "binding",
    "pr_number",
    "reviewed_head_sha",
    "base_sha",
    "merge_commit_sha",
    "merge_tree_sha",
    "bound_files",
    "gate_record_id",
    "review_record_ids",
    "jira_transition_record_id",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_id",
        "issue_id",
        "requirements_hash",
        "contract_hash",
        "policy_hash",
        "candidate_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reviewed_head_sha": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_sha": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$"
    },
    "merge_commit_sha": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$"
    },
    "merge_tree_sha": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$"
    },
    "bound_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "blob_sha",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "blob_sha": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{40}$"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "gate_record_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid"
    },
    "review_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uuid"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "jira_transition_record_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uri"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awf:1.2:closeout-record",
  "title": "Agentic Workflow 1.2 \u2014 closeout-record"
}
