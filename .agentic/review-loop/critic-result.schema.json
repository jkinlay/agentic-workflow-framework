{
  "$comment": "The raw critic result is wrapped by the host in the v2 critic binding envelope below; authority never comes from model-supplied binding fields.",
  "x-awf-host-envelope-version": 2,
  "x-awf-sole-critic-run-carrier": "#/$defs/criticBinding/properties/critic_run_carrier",
  "$defs": {
    "criticBinding": {
      "type": "object",
      "properties": {
        "controller_run_id": {"type": "string", "format": "uuid"},
        "critic_run_id": {"type": "string", "format": "uuid"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "critic_run_carrier": {"type": "string", "pattern": "^Critic run: [0-9a-f-]{36}$"},
        "provider_comment_id": {"type": "integer", "minimum": 1},
        "provider_comment_url": {"type": "string", "pattern": "^https://github.com/"},
        "provider_actor_id": {"type": "integer", "minimum": 1},
        "provider_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["controller_run_id", "critic_run_id", "head_sha", "result_sha256", "critic_run_carrier", "provider_comment_id", "provider_comment_url", "provider_actor_id", "provider_body_sha256"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "candidate": {
      "type": "object",
      "properties": {
        "repository_id": {
          "type": "integer"
        },
        "pr": {
          "type": "integer"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "head_ref": {
          "type": "string"
        },
        "base_ref": {
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "pr",
        "head",
        "base",
        "head_ref",
        "base_ref"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVE",
        "CHANGES_REQUESTED",
        "BLOCKED"
      ]
    },
    "reviewed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "DISPUTED",
              "RESOLVED"
            ]
          },
          "file": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "basis": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(criterion:.+|boundary:(PROTECTED_PATH|SCOPE_ESCAPE|CREDENTIAL_EXPOSURE|UNSAFE_PATH|UNREGISTERED_PRODUCER|CI_BINDING|INDEPENDENCE))$"
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "severity",
          "status",
          "file",
          "message",
          "evidence",
          "basis",
          "supersedes"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "verdict",
    "reviewed_files",
    "findings",
    "summary"
  ],
  "additionalProperties": false
}
