# This directory is an all-text release, including its exact-byte manifests.
# Keep checkout bytes stable on Windows even when core.autocrlf=true.
# This broad source rule is NOT installed over a target project's attributes.
* text eol=lf
.agentic/tests/fixtures/upgrades/blobs/** -text
.agentic/tests/fixtures/upgrades/blobs/** -text whitespace=cr-at-eol
# The built-in union driver needs no host-local Git configuration. Each
# manifest entry occupies one complete line; CI rejects duplicate/stale rows.
# AWF tooling can still invoke scripts/manifest_merge_driver.py directly when
# it needs a canonical three-way merge of the derived inventories.
MANIFEST.json merge=union
MANIFEST.md merge=union
